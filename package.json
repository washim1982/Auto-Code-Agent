{
  "name": "auto-code-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rm -rf packages/*/dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "aca": "node --import tsx packages/cli/src/bin.ts",
    "daemon": "node --import tsx packages/daemon/src/bin.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@aca/cli": "workspace:^",
    "@aca/core": "workspace:^",
    "@aca/daemon": "workspace:^",
    "@aca/protocol": "workspace:^",
    "@aca/providers": "workspace:^",
    "@aca/tools": "workspace:^"
  }
}
